---
import Layout from "../../layouts/Layout.astro"
import { Image } from "astro:assets";
import playstationbg from "../../assets/multimedia/playstation/playstationbg.jpg";
import { target } from "../../features/games/Games.module";

---

<Layout>
	<!-- formulario -->
    <main class="playstation">
		<div class="container">
  <h1>Añadir Nuevo Juego</h1>

  <form id="itemForm" class="item-form">
    <div class="form-group">
      <label for="itemName" class="text-white">Nombre:</label>
      <input type="text" id="itemName" required>
    </div>

    <div class="form-group">
      <label for="itemDescription">Descripción:</label>
      <textarea id="itemDescription" required></textarea>
    </div>

    <div class="form-group">
      <label for="itemQuantity">Cantidad:</label>
      <input type="number" id="itemQuantity" min="1" required>
    </div>

    <div class="form-group">
      <label for="itemImage">URL de la Imagen:</label>
      <input type="url" id="itemImage" required>
    </div>

    <button type="submit" class="submit-button">Agregar a la lista</button>
  </form>
  <!--  lista de los juegos -->
<h2>Lista de Juegos</h2>
  <ul id="itemList" class="item-list">
    <!-- Los elementos de la lista se agregarán aquí dinámicamente -->
    </ul>
</div>

	</main>
</Layout>
<script>
	//agregar juegos
	let games = [];
	
	const addgame = (newGame) => {
	games = games.concat(games);
	}
	//guardar de forma local hasta que consiga como conectar con el backend
	const saveGamesInLocalStorage = (games) => {
		localStorage.setItem('games', JSON.stringify(games));
	}
	//cargar los juegos guardados en el local storage
	const loadGamesFromLocalStorage = () => {
		// obtener los juegos guardados en el local storage
		const savedGames = localStorage.getItem('games');
		//transformar los juegos guardados de json a javascript
		const GamesLocal = JSON.parse(savedGames);
		//guardar los juegos
		games = GamesLocal ?? [];
		
	}

// Opcional: Función para agregar nuevos elementos, si es necesario.
// function addItem() { ... }
  
const itemForm = document.getElementById('itemForm');
const itemList = document.getElementById('itemList');
 itemForm.addEventListener('submit', function(event) {
 // Evita recargar la página
event.preventDefault();

// Obtiene los valores de los campos del formulario
const itemName = document.getElementById('itemName').value;
const itemDescription = document.getElementById('itemDescription').value;
const itemQuantity = document.getElementById('itemQuantity').value;
const itemImage = document.getElementById('itemImage').value;

// Crea un nuevo juego de la lista (<li>)
const newItem = document.createElement('li');
newItem.className = 'item-card';

// Rellena el HTML del nuevo juego con los datos capturados
newItem.innerHTML = `
<img src="${itemImage}" alt="${itemName}">
<div class="item-info">
<h3>${itemName}</h3>
<p><strong>Descripción:</strong> ${itemDescription}</p>
<p><strong>Cantidad:</strong> ${itemQuantity}</p>
</div>
`;

// Añade el nuevo juego a la lista
itemList.appendChild(newItem);

// Limpia el formulario
itemForm.reset();
});
</script>
<style>
	html,
	.playstation{
		margin: 0;
		width: 100%;
		height: 100%;
		background-image: url('../../assets/multimedia/playstation/bg.jpg');
		background-size: cover;
		background-position: center;
		overflow: hidden;	
	}
	h2, h1{
		text-align: center;
		
	}
	ul{
		max-height: 400px;
		overflow: auto;
	}
	 .container {
    max-width: 800px;
    margin: 20px auto;
    padding: 20px;
    background-color: #f0f4f83b;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
	color: white;
  }

  .item-form, .item-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
	color: white;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  label {
    margin-bottom: 5px;
    font-weight: bold;
    color: white;
  }

  input[type="text"],
  input[type="number"],
  input[type="url"],
  textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  .submit-button {
    padding: 12px 20px;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
  }

  .submit-button:hover {
    background-color: #0056b3;
  }

  .item-list {
    list-style: none;
    padding: 0;
  }

  .item-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background-color: #fff;
  }
  
  .item-card img {
    max-width: 150px;
    height: auto;
    border-radius: 4px;
    margin-bottom: 10px;
  }

  .item-info {
    text-align: center;
  }
  .item-text[contenteditable="true"] {
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: #f9f9f9;
}
.actions button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    margin-left: 5px;
    color: #555;
    transition: color 0.2s;
}
.actions button:hover {
    color: #000;
}
.delete-btn:hover {
    color: #e74c3c;
}
.edit-btn:hover {
    color: #3498db;
}


  /* Media Queries para Responsividad */
  @media (min-width: 600px) {
    .item-card {
      flex-direction: row;
      align-items: flex-start;
      gap: 20px;
    }

    .item-card img {
      margin-bottom: 0;
    }

    .item-info {
      text-align: left;
    }
  }

</style>