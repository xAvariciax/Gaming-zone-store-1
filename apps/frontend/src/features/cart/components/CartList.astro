---
import CartItem from "./CartItem.astro";
---

<ul
  id="games-cart-list"
  class="m-0 p-2 list-none overflow-auto flex flex-col gap-8 rounded-md border border-gray-300 h-full md:w-[70%] lg:w-[50%]"
>
  <template id="game-cart-item-template">
    <CartItem game={{ id: 0, name: "", price: 0 }} quantity={0} />
  </template>
  <p id="empty-cart-message" class="text-center text-gray-500 hidden">
    Aún no has agregado productos a tu carrito.
  </p>
</ul>

<script>
  // @ts-nocheck
  import cartService from "./cart.module.js";
  import { cart } from "./cart.module.js";
  import { createNotification } from "../../notifications/notificiation";
  const gamesCartList = document.querySelector("#games-cart-list");
  const gameCartItemTemplate = document.querySelector(
    "#game-cart-item-template"
  );
  const emptyCartMessage = document.querySelector("#empty-cart-message");

  const renderCart = (cartItems) => {
    gamesCartList.innerHTML = "";

    if (cartItems.length === 0) {
      emptyCartMessage.classList.remove("hidden");
      return;
    }
    emptyCartMessage.classList.add("hidden");

    for (const cartItem of cartItems) {
      const gameItem = gameCartItemTemplate.content.cloneNode(true);

      const cartItemElement = gameItem.querySelector(".cart-item");
      const quantitySpan = gameItem.querySelector(".quantity");
      const decreaseBtn = gameItem.querySelector(".decrease-quantity-btn");
      const increaseBtn = gameItem.querySelector(".increase-quantity-btn");
      const removeBtn = gameItem.querySelector(".remove-item-btn");

      cartItemElement.dataset.gameId = cartItem.gameId;
      gameItem.querySelector("h3").textContent = cartItem.name;
      gameItem.querySelector("p").textContent =
        `$${cartItem.price.toFixed(2)}`;
      quantitySpan.textContent = cartItem.quantity;

      decreaseBtn.addEventListener("click", () => {
        cartService.updateGameQuantityInLocalStorage({
          gameId: cartItem.gameId,
          newQuantity: cartItem.quantity - 1,
        });
      });

      increaseBtn.addEventListener("click", () => {
        cartService.updateGameQuantityInLocalStorage({
          gameId: cartItem.gameId,
          newQuantity: cartItem.quantity + 1,
        });
      });

      removeBtn.addEventListener("click", () => {
        cartService.removeGameFromLocalStorage({
          gameId: cartItem.gameId,
        });
        createNotification({
          title: "Juego Eliminado",
          description: "El juego se ha eliminado de tu carrito.",
          type: "success",
        });
      });

      // Agregamos el item a la lista
      gamesCartList.appendChild(gameItem);
    }
  };

  cart.subscribe(renderCart);

  renderCart(cart.get());
</script>
