---
const { name, quantity, id, description, url, price } = Astro.props;
import { Icon } from 'astro-icon/components';
import cartService from '../cart/components/cart.module';
---

<li id={id} 
    class="game-item flex gap-4 justify-between items-center" 
    data-status="inputs-deshabilitados" 
    data-item-id={id} 
>
 <div class="inputs-container flex flex-wrap md:flex-nowrap gap-2 flex-grow">
  <input name="name" class="w-full bg-gray-100 rounded-md p-2 outline-none" type="text" value={name} readonly>
  <input name="quantity" class="w-full bg-gray-100 rounded-md p-2 outline-none" type="text" value={quantity} readonly>
  <input name="description" class="w-full bg-gray-100 rounded-md p-2 outline-none" type="text" value={description} readonly>
  <input name="url" class="w-full bg-gray-100 rounded-md p-2 outline-none" type="url" value={url} readonly>
  <input name="price" class="w-full bg-gray-100 rounded-md p-2 outline-none" type="number" value={price} readonly>
 </div>
 <div class="flex gap-2 items-center">
    
    
  <button class="edit-btn w-8 h-8 flex justify-center items-center text-gray-600 hover:text-indigo-700" aria-label="Editar juego">
   <Icon name="mdi:pencil" class="icon-edit w-6 h-6" is:inline/>
   <Icon name="mdi:content-save" class="icon-save w-6 h-6 hidden" is:inline/>
  </button>
    
    
  <button class="delete-btn w-8 h-8 flex justify-center items-center text-gray-600 hover:text-red-600" aria-label="Eliminar juego">
   <Icon name="mdi:alpha-x" class="w-6 h-6" is:inline/>
  </button>
    
    
  <button
   class="add-to-cart-btn w-full py-2 px-4 text-sm font-medium text-white bg-lime-600 rounded-lg hover:bg-lime-700"
   data-product-id={id}
   data-product-name={name}
   data-product-price={price}
   data-product-quantity={quantity}
   id={`add-to-cart-${id}`}
  >
   Añadir al carrito
  </button>
 </div>
</li>

