</nav>

<style>
  #cart {
  position: absolute;
  top: 4rem;
  right: 0;
  background-color: rgb(113, 195, 243);
  height: 25rem;
  width: 20rem;
  display: flex;
  flex-direction: column;      /* Coloca todo en columna */
  align-items: center;         /* Centra horizontalmente */
  justify-content: center;     /* Centra verticalmente */
  gap: 1rem;                   /* Espacio entre elementos */
  padding: 1rem;
  box-sizing: border-box;
}

table {
  table-layout: fixed;
  border-collapse: collapse;
  width: 100%;                 /* Que la tabla ocupe todo el ancho */
  text-align: center;
}

th.table-title {
  padding: 0.5rem;
  background-color: #367bf5;
  color: white;
}

td.text-center {
  padding: 0.5rem;
}

#cart-clear {
  cursor: pointer;
  padding: 0.5rem 1rem;
  background-color: #f44336;
  border: none;
  color: white;
  border-radius: 4px;
  font-weight: bold;
  width: 150px;
  text-align: center;
}

</style>