---
import GameCard from "./GameCard.astro";
---

<ul
  id="games-list-client"
  class="m-0 p-2 list-none overflow-auto flex-col gap-8 rounded-md h-full md:w-[70%] lg:w-[50%] hidden"
>
  <template id="game-item-template">
    <GameCard name="Hollow knight" price={0} id={0} />
  </template>
</ul>

<script>
  // @ts-nocheck
  import GamesModule, {
    gamesFiltered,
  } from "../../features/games/Games.module.js";
  const gamesList = document.querySelector("#games-list-client");
  const gameItemTemplate = document.querySelector("#game-item-template");

  // Al cargar, obtenemos los games y los guardamos en la tienda 'games'
  // pero no los renderizamos.
  await GamesModule.getGames();

  const renderGames = (gamesToRender) => {
    gamesList.innerHTML = "";
    gamesToRender.forEach((game) => {
      const gameCard = gameItemTemplate.content.cloneNode(true);
      gameCard.querySelector("h3").textContent = game.name;
      gameCard.querySelector("p").textContent = `$${game.price}`;

      const addButton = gameCard.querySelector(".add-to-cart-btn");
      addButton.dataset.gameId = game.id;
      addButton.dataset.gameName = game.name;
      addButton.dataset.gamePrice = game.price;

      gamesList.appendChild(gameCard);
    });
  };

  // Escucha los cambios en la tienda de gameos filtrados.
  gamesFiltered.subscribe((filteredGames) => {
    // Si hay productos filtrados, los renderizamos y mostramos la lista.
    if (filteredGames.length > 0) {
      renderGames(filteredGames);
      gamesList.classList.remove("hidden");
    } else {
      // Si la lista de filtrados está vacía, ocultamos la lista.
      gamesList.classList.add("hidden");
    }
  });
</script>
